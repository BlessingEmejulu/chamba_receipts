# Pollar Publishable API Key
# Obtain from your Pollar Dashboard (https://dashboard.pollar.xyz - Build -> API Keys)
# Key starts with pub_testnet_ for testnet or pub_mainnet_ for mainnet
NEXT_PUBLIC_POLLAR_PUBLISHABLE_KEY=pub_testnet_your_publishable_key_here

# Optional: Stellar Horizon URL override (defaults to testnet)
# NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# Optional: Circle USDC Issuer override (defaults to Circle testnet USDC issuer)
# NEXT_PUBLIC_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
